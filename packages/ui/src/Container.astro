---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;

const sizes = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-7xl',
  xl: 'max-w-[90rem]',
  full: 'max-w-full',
};

const classes = ['mx-auto w-full px-4 sm:px-6 lg:px-8', sizes[size], className].filter(Boolean).join(' ');
---

<div class={classes}>
  <slot />
</div>
