---
interface Props {
  id?: string;
  background?: 'default' | 'muted' | 'dark' | 'brand';
  spacing?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const { id, background = 'default', spacing = 'lg', class: className } = Astro.props;

const backgrounds = {
  default: 'bg-white dark:bg-gray-950',
  muted: 'bg-gray-50 dark:bg-gray-900',
  dark: 'bg-gray-950 text-white',
  brand: 'bg-brand-600 text-white',
};

const spacings = {
  sm: 'py-12 lg:py-16',
  md: 'py-16 lg:py-20',
  lg: 'py-20 lg:py-28',
  xl: 'py-24 lg:py-36',
};

const classes = [backgrounds[background], spacings[spacing], className].filter(Boolean).join(' ');
---

<section id={id} class={classes}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
