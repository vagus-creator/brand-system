---
interface Props {
  brand: string;
  links?: { label: string; href: string }[];
  class?: string;
}

const { brand, links = [], class: className } = Astro.props;
---

<header class={`fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur-lg border-b border-gray-200/50 dark:border-gray-800/50 ${className || ''}`}>
  <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16 lg:h-18">
    <a href="/" class="text-xl font-bold font-display text-gray-900 dark:text-white tracking-tight">
      {brand}
    </a>
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <slot name="cta" />
    </div>
    <button class="md:hidden p-2 text-gray-600 dark:text-gray-400" aria-label="Menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
</header>
