---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { title, subtitle, align = 'center', class: className } = Astro.props;

const alignClasses = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<section class={`relative flex flex-col ${alignClasses} justify-center min-h-[80vh] py-20 lg:py-32 ${className || ''}`}>
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-gray-900 dark:text-gray-50 leading-tight">
      <Fragment set:html={title} />
    </h1>
    {subtitle && (
      <p class="mt-6 text-xl sm:text-2xl text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mx-auto font-light">
        {subtitle}
      </p>
    )}
    <div class="mt-10 flex flex-wrap gap-4 justify-center">
      <slot />
    </div>
  </div>
  <slot name="background" />
</section>
