---
interface Props {
  brand: string;
  year?: number;
  links?: { label: string; href: string }[];
  class?: string;
}

const { brand, year = new Date().getFullYear(), links = [], class: className } = Astro.props;
---

<footer class={`bg-gray-950 text-gray-400 py-12 lg:py-16 ${className || ''}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-center md:text-left">
        <p class="text-white font-display font-bold text-lg">{brand}</p>
        <p class="text-sm mt-1">&copy; {year} {brand}. All rights reserved.</p>
      </div>
      {links.length > 0 && (
        <nav class="flex flex-wrap gap-6">
          {links.map((link) => (
            <a
              href={link.href}
              class="text-sm hover:text-white transition-colors duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}
    </div>
  </div>
</footer>
