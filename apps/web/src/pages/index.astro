---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '@brand-system/ui/Navbar.astro';
import Hero from '@brand-system/ui/Hero.astro';
import Section from '@brand-system/ui/Section.astro';
import Card from '@brand-system/ui/Card.astro';
import Button from '@brand-system/ui/Button.astro';
import Badge from '@brand-system/ui/Badge.astro';
import Footer from '@brand-system/ui/Footer.astro';

const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Pricing', href: '#pricing' },
  { label: 'About', href: '#about' },
];

const features = [
  {
    icon: '🎨',
    title: 'Design Tokens',
    description: 'Ein einheitliches Token-System für Farben, Typografie, Spacing und Schatten – konsistent über alle Plattformen.',
  },
  {
    icon: '⚡',
    title: 'Blitzschnell',
    description: 'Statisch generiert mit Astro. Null JavaScript im Client. Perfekte Lighthouse-Scores.',
  },
  {
    icon: '🧩',
    title: 'Modular',
    description: 'Wiederverwendbare Komponenten, die sich wie Lego zusammensetzen. Von der Navbar bis zum Footer.',
  },
  {
    icon: '🌗',
    title: 'Dark Mode',
    description: 'Vollständiges Light/Dark-Theme-System, gesteuert durch semantische Design Tokens.',
  },
  {
    icon: '📐',
    title: 'Responsive',
    description: 'Mobile-first Design mit durchdachten Breakpoints. Perfekt auf jedem Gerät.',
  },
  {
    icon: '🏷️',
    title: 'Multi-Brand',
    description: 'Ein System, viele Marken. Tausche Tokens aus und erhalte ein komplett neues Branding.',
  },
];

const pricing = [
  {
    name: 'Starter',
    price: '0',
    description: 'Für persönliche Projekte',
    features: ['1 Brand-Theme', '5 Komponenten', 'Community Support', 'MIT Lizenz'],
    cta: 'Kostenlos starten',
    highlighted: false,
  },
  {
    name: 'Professional',
    price: '49',
    description: 'Für Freelancer & Agenturen',
    features: ['Unbegrenzte Themes', 'Alle Komponenten', 'Slidev Integration', 'Priority Support', 'Figma Tokens Sync'],
    cta: 'Jetzt starten',
    highlighted: true,
  },
  {
    name: 'Enterprise',
    price: '199',
    description: 'Für Teams & Organisationen',
    features: ['Alles aus Professional', 'Custom Komponenten', 'Onboarding-Session', 'SLA Garantie', 'White-Label'],
    cta: 'Kontakt aufnehmen',
    highlighted: false,
  },
];
---

<BaseLayout title="Brand System – Design auf höchstem Niveau" description="Professionelles Design-System für Websites und Slide Decks. Multi-Brand-fähig, blitzschnell, modular.">
  <Navbar brand="BrandSystem" links={navLinks}>
    <Button slot="cta" variant="primary" size="sm" href="#pricing">Get Started</Button>
  </Navbar>

  <!-- Hero -->
  <Hero
    title='Design-System<br class="hidden sm:block" /><span class="text-brand-600"> ohne Kompromisse.</span>'
    subtitle="Baue markenkonform Websites und Slide Decks auf dem höchsten Designer-Level. Ein System, unendliche Möglichkeiten."
  >
    <Button variant="primary" size="lg" href="#features">Entdecken</Button>
    <Button variant="secondary" size="lg" href="https://github.com">GitHub →</Button>
    <Fragment slot="background">
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-200/30 rounded-full blur-3xl"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent-200/20 rounded-full blur-3xl"></div>
      </div>
    </Fragment>
  </Hero>

  <!-- Features -->
  <Section id="features" background="muted">
    <div class="text-center mb-16">
      <Badge variant="brand">Features</Badge>
      <h2 class="mt-4 text-4xl lg:text-5xl font-extrabold font-display text-gray-900 tracking-tight">
        Alles, was du brauchst.
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Ein durchdachtes System, das dir erlaubt, dich auf das Wesentliche zu konzentrieren: großartiges Design.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {features.map((feature) => (
        <Card variant="elevated" padding="lg">
          <div class="text-3xl mb-4">{feature.icon}</div>
          <h3 class="text-xl font-semibold font-display text-gray-900 mb-2">{feature.title}</h3>
          <p class="text-gray-600 leading-relaxed">{feature.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Pricing -->
  <Section id="pricing" background="default" spacing="xl">
    <div class="text-center mb-16">
      <Badge variant="accent">Pricing</Badge>
      <h2 class="mt-4 text-4xl lg:text-5xl font-extrabold font-display text-gray-900 tracking-tight">
        Einfache, faire Preise.
      </h2>
      <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto">
        Starte kostenlos und skaliere, wenn du wächst.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
      {pricing.map((plan) => (
        <Card
          variant={plan.highlighted ? 'elevated' : 'bordered'}
          padding="lg"
          class={plan.highlighted ? 'ring-2 ring-brand-500 scale-105' : ''}
        >
          {plan.highlighted && (
            <Badge variant="brand" class="mb-4">Beliebt</Badge>
          )}
          <h3 class="text-xl font-semibold font-display text-gray-900">{plan.name}</h3>
          <p class="text-sm text-gray-500 mt-1">{plan.description}</p>
          <div class="mt-6 mb-6">
            <span class="text-4xl font-extrabold text-gray-900">€{plan.price}</span>
            <span class="text-gray-500">/Monat</span>
          </div>
          <ul class="space-y-3 mb-8">
            {plan.features.map((f) => (
              <li class="flex items-center gap-2 text-sm text-gray-600">
                <svg class="w-4 h-4 text-brand-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {f}
              </li>
            ))}
          </ul>
          <Button variant={plan.highlighted ? 'primary' : 'secondary'} size="md" class="w-full">
            {plan.cta}
          </Button>
        </Card>
      ))}
    </div>
  </Section>

  <!-- About / CTA -->
  <Section id="about" background="dark" spacing="xl">
    <div class="text-center max-w-3xl mx-auto">
      <h2 class="text-4xl lg:text-5xl font-extrabold font-display text-white tracking-tight">
        Bereit, dein Design<br />auf das nächste Level zu heben?
      </h2>
      <p class="mt-6 text-xl text-gray-400 leading-relaxed">
        Starte jetzt mit dem Brand System und baue Websites und Präsentationen, die beeindrucken.
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <Button variant="primary" size="lg" href="#">Jetzt starten</Button>
        <Button variant="ghost" size="lg" href="#" class="text-gray-300 hover:text-white">
          Dokumentation lesen →
        </Button>
      </div>
    </div>
  </Section>

  <Footer
    brand="BrandSystem"
    links={[
      { label: 'GitHub', href: 'https://github.com' },
      { label: 'Dokumentation', href: '#' },
      { label: 'Impressum', href: '#' },
      { label: 'Datenschutz', href: '#' },
    ]}
  />
</BaseLayout>
